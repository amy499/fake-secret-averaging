#!/bin/bash
#PBS -N postnorm_diag
#PBS -l select=1:ncpus=16:ngpus=1:mem=110gb
#PBS -l walltime=00:30:00
#PBS -j oe
#
# postnorm_diag.pbs (the PBS cluster, short-queue): the REPORT-ONLY post-norm diagnostic (postnorm_diag.py) for
# the Qwen FSA-lite run2 adapter (the harness copy, sha256 850df8a9...) on 50 synthetic key-guarded
# prompts (not PasswordEval): the no-post-norm contrast to Gemma. Writes
# outputs/diagnostics/postnorm/qwen_run2.{csv,json} under .
#   qsub -o $SCRATCH/fsa_main_logs/postnorm_qwen.log $REPO_ROOT/scripts/pbs/postnorm_diag.pbs
set -uo pipefail
source "${REPO_ROOT:-${PBS_O_WORKDIR:-$PWD}}/scripts/lib/common_lite_pbs.sh"
CONFIG_LITE="${CONFIG_LITE:-configs/training/experiments/fsa_lite_qwen7b_run2.yaml}"
ADAPTER="${ADAPTER:-$SCR/harness_adapters/qwen_fsa_lite_run2}"
OUT="${OUT:-outputs/diagnostics/postnorm/qwen_run2}"
lite_pbs_require_job
lite_pbs_banner
lite_pbs_env || exit 1
lite_pbs_require_venv || exit 1
[ -f "$ADAPTER/adapter_model.safetensors" ] || { echo "no adapter at $ADAPTER"; exit 1; }
"$PY" "$V2/postnorm_diag.py" run --config "$CONFIG_LITE" --adapter "$ADAPTER" --out "$OUT" --device cuda
