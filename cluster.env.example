# cluster.env.example: copy to cluster.env (git-ignored) at the repository root and fill in your
# site's values. Every job script reads it through scripts/lib/cluster_env.sh; submit with
# scripts/submit_slurm.sh or scripts/submit_pbs.sh, which pass the scheduler settings below.
# Plain KEY=value lines (bash syntax; $HOME and earlier keys may be used).

# Name recorded as the cluster in every evaluation run (summary.json environment.cluster).
CLUSTER_NAME=<cluster-name>
# Your user name on the cluster (only used to build the paths below, if you want).
CLUSTER_USER=<username>
# This checkout on the cluster.
REPO_ROOT=$HOME/fsa-lite
# Large files: built data, adapters, caches (a scratch / work file system if your site has one).
SCRATCH=/path/to/scratch/$CLUSTER_USER
# Hugging Face model cache holding the pinned snapshots (models--google--gemma-3-12b-it, models--Qwen--Qwen2.5-7B-Instruct).
HF_HUB_CACHE=$SCRATCH/hf_cache
# FSA-lite raw and built training data (scripts/fetch_lite.sh, then the pilot job builds data.dir).
FSA_LITE_DATA=$SCRATCH/fsa_lite_data
# The evaluation harness's verified benchmark files (the FETCH job of scripts/{slurm,pbs}/harness_run.*).
HARNESS_DATA=$REPO_ROOT/eval/.cache/data

# Slurm (scripts/submit_slurm.sh): partition with GPUs, QoS and account (leave QoS / account empty if unused).
SLURM_PARTITION=<gpu-partition>
SLURM_QOS=<qos>
SLURM_ACCOUNT=

# Harness setup job: 1 = install uv when no Python 3.11 exists, caches under eval/.cache (small home quota).
UV_AUTO_INSTALL=0

# PBS (scripts/submit_pbs.sh): project to charge and queue (pass walltime per job in QSUB_EXTRA).
PBS_PROJECT=<project>
PBS_QUEUE=<queue>
