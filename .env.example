# Copy to .env (never commit .env). Values here override configs/training/app.yaml.

# mock = synthetic generator + mock_data/runs ; real = HF models + outputs/runs
FSA_BACKEND=mock

FSA_API_HOST=127.0.0.1
FSA_API_PORT=8001

# Relative paths are resolved against 
FSA_RUNS_DIR=outputs/runs
FSA_MOCK_RUNS_DIR=mock_data/runs

FSA_SEED=0

# --- Later, on the GPU cluster ---
HF_TOKEN=
HF_HOME=
